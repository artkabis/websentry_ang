{
  "name": "@websentry/web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "ng build",
    "dev": "ng serve",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
