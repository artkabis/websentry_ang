# ─────────────────────────────────────────────────────────────────────────────
# WebSentry v2 — variables d'environnement
#
# Copier ce fichier en `.env` À LA RACINE du dépôt (ou dans apps/api/ pour un
# réglage propre à l'API, qui prend alors le pas).
#
# Toutes les variables sont validées par Zod AU DÉMARRAGE : une valeur manquante
# ou aberrante fait échouer le boot plutôt que de laisser tourner un serveur à
# moitié configuré. Voir apps/api/src/config/env.schema.ts.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3031
HOST=0.0.0.0

# Origines autorisées par CORS (séparées par des virgules).
CORS_ORIGIN=http://localhost:4200

# ── Authentification ─────────────────────────────────────────────────────────
# OBLIGATOIRE, 32 caractères minimum. Générer avec : openssl rand -hex 32
# Un secret deviné équivaut à une usurpation d'identité totale.
JWT_SECRET=

# Durées en secondes. ACCESS_TOKEN_TTL est de toute façon plafonné à 900 s
# côté applicatif : une valeur plus élevée ici n'allonge rien.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Verrouillage de compte après N échecs consécutifs.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ── Base de données MariaDB ──────────────────────────────────────────────────
# DB_ENABLED=false permet de démarrer sans base (développement, tests).
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=websentry
DB_USER=websentry
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ── Moteur d'analyse ─────────────────────────────────────────────────────────
# Le worker est du JavaScript COMPILÉ : un thread Piscina est un vrai thread
# Node, sans transformation TypeScript. En développement, l'analyse s'exécute
# donc en ligne — c'est normal et signalé au démarrage.
ANALYSIS_WORKERS_ENABLED=true
# 0 = automatique : un thread de moins que de cœurs disponibles.
ANALYSIS_MAX_WORKERS=0
# Pages analysées en parallèle dans un lot — borne l'egress simultané.
ANALYSIS_BATCH_CONCURRENCY=4

# ── Rétention de l'historique des scans ──────────────────────────────────────
# Le rapport complet est compressé après N jours, puis purgé après N jours.
# Le RÉSUMÉ des critères (`check_summary`) n'est jamais purgé : c'est lui qui
# rend deux scans anciens encore comparables.
# La purge DOIT être strictement postérieure à la compression — le démarrage
# échoue sinon, plutôt que de laisser la compression devenir inutile en silence.
SCAN_COMPRESS_AFTER_DAYS=7
SCAN_PURGE_AFTER_DAYS=180
# Lignes traitées par passage du travail de fond — borne les verrous pris.
SCAN_RETENTION_BATCH=500
SCAN_RETENTION_ENABLED=true

# ── Sorties HTTP (analyseurs) ────────────────────────────────────────────────
FETCH_USER_AGENT=Mozilla/5.0 (compatible; WebSentry/2.0; +https://websentry.artkabis.fr/bot)
FETCH_TIMEOUT_MS=15000

# ── Messagerie ───────────────────────────────────────────────────────────────
# Dossier des pièces jointes — HORS de toute arborescence servie. Aucune route
# ne sert de fichier statique : le contenu est lu par le service et renvoyé
# sous un identifiant, jamais sous un chemin.
MESSAGE_UPLOADS_DIR=./data/pieces-jointes

LOG_LEVEL=info
